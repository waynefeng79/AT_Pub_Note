JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=at_public_note_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
DATABASE_URL=postgresql://at:at@127.0.0.1:5432/at_pub_note
REDIS_URL=redis://127.0.0.1:6379/0
WEB_CONCURRENCY=2
# Optional Docker Compose overrides. Leave blank for normal local compose networking.
COMPOSE_DATABASE_URL=
COMPOSE_REDIS_URL=
COMPOSE_FRONTEND_ORIGINS=
GTFS_STATIC_URL=https://gtfs.at.govt.nz/gtfs.zip
GTFS_STATIC_ZIP_PATH=../data/gtfs.zip
GTFS_STATIC_POLL_SECONDS=3600
GTFS_RETAIN_INACTIVE_FEEDS=2
GTFS_REALTIME_URL=https://api.at.govt.nz/realtime/legacy/
REALTIME_RAW_PATH=../data/RealTimeRaw.json
REALTIME_FEED_FORMAT=auto
GTFS_REALTIME_POLL_SECONDS=30
GTFS_REALTIME_LOCK_TTL_SECONDS=600
AT_API_KEY=
AT_API_KEY_HEADER=Ocp-Apim-Subscription-Key
FRONTEND_ORIGINS=http://localhost:5173
SPATIAL_CACHE_ENABLED=true
SPATIAL_CACHE_TTL_SECONDS=900
SPATIAL_CACHE_CELL_PRECISION=3
PUBLIC_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=
VITE_MAP_STYLE_URL=
