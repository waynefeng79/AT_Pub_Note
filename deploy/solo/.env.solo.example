BACKEND_DOMAIN=api.yuyuw.xyz
ACME_EMAIL=admin@example.com

POSTGRES_DB=at_pub_note
POSTGRES_USER=at
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql://at:replace-with-strong-password@postgres:5432/at_pub_note
FRONTEND_ORIGINS=https://www.yuyuw.xyz,https://yuyuw.xyz

JWT_SECRET_KEY=replace-with-long-random-secret
JWT_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=at_public_note_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none
WEB_CONCURRENCY=1

GTFS_STATIC_URL=https://gtfs.at.govt.nz/gtfs.zip
GTFS_STATIC_POLL_SECONDS=3600
GTFS_RETAIN_INACTIVE_FEEDS=2
GTFS_REALTIME_URL=https://api.at.govt.nz/realtime/legacy/
REALTIME_FEED_FORMAT=auto
GTFS_REALTIME_POLL_SECONDS=30
GTFS_REALTIME_LOCK_TTL_SECONDS=600

AT_API_KEY=replace-with-auckland-transport-api-key
AT_API_KEY_HEADER=Ocp-Apim-Subscription-Key

SPATIAL_CACHE_ENABLED=true
SPATIAL_CACHE_TTL_SECONDS=900
SPATIAL_CACHE_CELL_PRECISION=3

# Keep the backend and frontend feature flags disabled until verification is complete.
JOURNEY_PLANNER_ENABLED=false
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_PUBLIC_POLICY=true
NOMINATIM_USER_AGENT=AT-Public-Note/1.0
NOMINATIM_CONTACT=ops@example.com
NOMINATIM_COUNTRY_CODES=nz
NOMINATIM_VIEWBOX=174.15,-37.25,175.35,-36.35
NOMINATIM_BOUNDED=true
NOMINATIM_LANGUAGE=en
NOMINATIM_TIMEOUT_SECONDS=8
GEOCODING_MIN_QUERY_LENGTH=3
GEOCODING_RESULT_LIMIT=8
GEOCODING_CACHE_TTL_SECONDS=86400
GEOCODING_NEGATIVE_CACHE_TTL_SECONDS=900
GEOCODING_REVERSE_CACHE_TTL_SECONDS=86400
GEOCODING_RATE_WAIT_SECONDS=2.5
JOURNEY_TIMEZONE=Pacific/Auckland
JOURNEY_ACCESS_RADIUS_M=1000
JOURNEY_WALKING_SPEED_MPS=1.2
JOURNEY_TRANSFER_RADIUS_M=400
JOURNEY_MAX_FOOTPATHS_PER_STOP=12
# Optional bidirectional exclusions, e.g. stop-a>stop-b,stop-c>stop-d
JOURNEY_FOOTPATH_DENYLIST=
JOURNEY_WALKING_SPEED_KMH=4.8
JOURNEY_WALKING_CIRCUIT_FACTOR=1.3
JOURNEY_TRANSFER_BUFFER_SECONDS=120
JOURNEY_MAX_TRANSFERS=2
JOURNEY_MAX_OPTIONS=5
JOURNEY_MAX_ACCESS_STOPS=12
JOURNEY_SEARCH_HORIZON_SECONDS=21600
JOURNEY_REQUESTS_PER_MINUTE=30
